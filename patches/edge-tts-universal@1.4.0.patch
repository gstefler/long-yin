@@ -468,7 +468,15 @@ var Communicate = class {
       messageQueue.push("close");
       if (resolveMessage) resolveMessage();
     });
-    await new Promise((resolve) => websocket.on("open", resolve));
+    // Patched (long-yin): a refused handshake (Microsoft intermittently answers 403)
+    // emits error + close but never "open", so upstream awaited here forever and the
+    // caller hung. Reject with the queued handshake error instead, so it can be retried.
+    await new Promise((resolve, reject) => {
+      websocket.once("open", resolve);
+      websocket.once("close", () => {
+        reject(messageQueue.find((m) => m instanceof Error) ?? new WebSocketError("WebSocket closed before opening"));
+      });
+    });
     websocket.send(
       `X-Timestamp:${dateToString()}\r
 Content-Type:application/json; charset=utf-8\r
